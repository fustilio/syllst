{
  "name": "syllst-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Syllst monorepo - Syllabus Syntax Tree ecosystem",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:examples": "pnpm --filter @syllst/examples test:run",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm build && pnpm lint:publish && changeset publish",
    "lint:publish": "pnpm --filter \"./packages/**\" exec publint"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "publint": "^0.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.4"
}
