{
  "name": "@syllst/glost",
  "version": "0.1.2",
  "description": "GLOST word-level annotation plugin for syllst",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./enrichers": {
      "types": "./src/enrichers/index.ts",
      "default": "./src/enrichers/index.ts"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "default": "./src/providers/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@syllst/core": "workspace:*",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile": "catalog:"
  },
  "peerDependencies": {
    "glost-core": ">=0.1.0",
    "glost-processor": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "glost-processor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/syllst.git",
    "directory": "packages/syllst-glost"
  },
  "keywords": [
    "syllst",
    "glost",
    "remark",
    "plugin",
    "language-learning",
    "annotations"
  ]
}
