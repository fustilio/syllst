{
  "name": "@syllst/glost",
  "version": "0.5.6",
  "description": "GLOST word-level annotation plugin for syllst",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enrichers": {
      "types": "./dist/enrichers/index.d.ts",
      "default": "./dist/enrichers/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    }
  },
  "dependencies": {
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "peerDependencies": {
    "@syllst/core": ">=0.6.1",
    "@glotblocks/glost-core": ">=0.6.0",
    "@glotblocks/glost-processor": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@glotblocks/glost-core": {
      "optional": true
    },
    "@glotblocks/glost-processor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mdast": "^4.0.0",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/syllst.git",
    "directory": "packages/syllst-glost"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "syllst",
    "glost",
    "remark",
    "plugin",
    "language-learning",
    "annotations"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  }
}
