{
  "name": "@syllst/glost",
  "version": "0.4.2",
  "description": "GLOST word-level annotation plugin for syllst",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enrichers": {
      "types": "./dist/enrichers/index.d.ts",
      "default": "./dist/enrichers/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@syllst/core": "workspace:*",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile": "catalog:"
  },
  "peerDependencies": {
    "@syllst/core": ">=0.4.0",
    "glost-core": ">=0.1.0",
    "glost-processor": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "glost-processor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/syllst.git",
    "directory": "packages/syllst-glost"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "syllst",
    "glost",
    "remark",
    "plugin",
    "language-learning",
    "annotations"
  ]
}
