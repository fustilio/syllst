{
  "name": "@syllst/content-shared",
  "version": "0.4.0",
  "description": "Shared utilities for SYLLST content packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@syllst/core": "workspace:*",
    "@syllst/processor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/syllst",
    "directory": "packages/syllst-content-shared"
  }
}
