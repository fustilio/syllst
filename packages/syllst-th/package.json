{
  "name": "@syllst/th",
  "version": "0.3.11",
  "description": "Thai SYLLST content - all Thai language syllabi in one package",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./alphabet": {
      "types": "./dist/syllabi/alphabet/index.d.ts",
      "import": "./dist/syllabi/alphabet/index.js",
      "default": "./dist/syllabi/alphabet/index.js"
    },
    "./vowels-tones": {
      "types": "./dist/syllabi/vowels-tones/index.d.ts",
      "import": "./dist/syllabi/vowels-tones/index.js",
      "default": "./dist/syllabi/vowels-tones/index.js"
    },
    "./numbers": {
      "types": "./dist/syllabi/numbers/index.d.ts",
      "import": "./dist/syllabi/numbers/index.js",
      "default": "./dist/syllabi/numbers/index.js"
    },
    "./essentials": {
      "types": "./dist/syllabi/essentials/index.d.ts",
      "import": "./dist/syllabi/essentials/index.js",
      "default": "./dist/syllabi/essentials/index.js"
    },
    "./food": {
      "types": "./dist/syllabi/food/index.d.ts",
      "import": "./dist/syllabi/food/index.js",
      "default": "./dist/syllabi/food/index.js"
    },
    "./travel": {
      "types": "./dist/syllabi/travel/index.d.ts",
      "import": "./dist/syllabi/travel/index.js",
      "default": "./dist/syllabi/travel/index.js"
    },
    "./dialogue": {
      "types": "./dist/syllabi/dialogue/index.d.ts",
      "import": "./dist/syllabi/dialogue/index.js",
      "default": "./dist/syllabi/dialogue/index.js"
    },
    "./grammar": {
      "types": "./dist/syllabi/grammar/index.d.ts",
      "import": "./dist/syllabi/grammar/index.js",
      "default": "./dist/syllabi/grammar/index.js"
    },
    "./reading": {
      "types": "./dist/syllabi/reading/index.d.ts",
      "import": "./dist/syllabi/reading/index.js",
      "default": "./dist/syllabi/reading/index.js"
    }
  },
  "files": [
    "dist",
    "src/syllabi/**/*.mdx"
  ],
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.7.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "@polyglot-bundles/th-lang": "^0.2.3",
    "@mdx-js/rollup": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.0.0"
  },
  "peerDependencies": {
    "@syllst/core": "workspace:*",
    "@syllst/processor": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "thai",
    "language-learning",
    "syllst",
    "mdx",
    "alphabet",
    "vocabulary",
    "grammar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/polyglot-bundles",
    "directory": "packages/th/syllst"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "validate": "tsx scripts/validate-ids.ts"
  }
}
