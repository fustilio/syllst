{
  "name": "@syllst/validator",
  "version": "0.4.10",
  "description": "CLI tool for validating Syllst MDX content",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "syllst-validate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@syllst/processor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/syllst.git",
    "directory": "packages/validator"
  },
  "keywords": [
    "syllst",
    "validator",
    "cli",
    "mdx",
    "curriculum"
  ],
  "scripts": {
    "build": "vite build && node -e \"const fs=require('fs'); const content=fs.readFileSync('dist/cli.js','utf-8'); if(!content.startsWith('#!')) fs.writeFileSync('dist/cli.js','#!/usr/bin/env node\\n'+content);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  }
}
