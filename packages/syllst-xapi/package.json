{
  "name": "@syllst/xapi",
  "version": "0.4.4",
  "description": "xAPI profile for language learning - verbs, activity types, extensions, and Zod schemas extending cmi5",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verbs": {
      "types": "./dist/verbs.d.ts",
      "default": "./dist/verbs.js"
    },
    "./activity-types": {
      "types": "./dist/activity-types.d.ts",
      "default": "./dist/activity-types.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "default": "./dist/extensions.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fustilio/syllst.git",
    "directory": "packages/syllst-xapi"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@syllst/core": ">=0.5.2"
  },
  "dependencies": {
    "@syllst/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "xapi",
    "cmi5",
    "language-learning",
    "verbs",
    "activity-types",
    "profile",
    "lrs",
    "syllst"
  ],
  "homepage": "https://github.com/fustilio/syllst#readme",
  "bugs": {
    "url": "https://github.com/fustilio/syllst/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
